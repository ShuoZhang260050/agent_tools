# LLM 配置
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-your-key-here
# 留空=官方端点；国产/本地模型填兼容端点，例如：
# 火山方舟 Ark: https://ark.cn-beijing.volces.com/api/v3  (模型名用 ark-code-latest 或 ep-xxxxx)
# 智谱 GLM:    https://open.bigmodel.cn/api/paas/v4
# 通义千问:    https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek:    https://api.deepseek.com
# 本地 Ollama: http://localhost:11434/v1
LLM_BASE_URL=
LLM_TEMPERATURE=0.7
# 前端模型下拉框；留空时只显示 LLM_MODEL。图片模型填到 VISION_MODELS。
AVAILABLE_MODELS=gpt-4o-mini
VISION_MODELS=

# 上下文工程
TOKEN_BUDGET=500000
MODEL_CALL_LIMIT=25
SUMMARY_TRIGGER_MESSAGES=30
SUMMARY_KEEP_MESSAGES=10
JWT_SECRET=please-change-this-to-a-long-random-secret-at-least-32-chars
TOKEN_EXPIRE_HOURS=168

# SQLite checkpointer 文件路径
SQLITE_PATH=checkpoints.sqlite

# RAG 知识库
# 嵌入模型：OpenAI 用 text-embedding-3-small；火山方舟用 doubao-embedding-text-240715 等
EMBEDDING_MODEL=text-embedding-3-small
# 留空=复用 LLM_BASE_URL / LLM_API_KEY
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3

# 可观测性
ENABLE_TRACING=true

# API 服务
API_HOST=0.0.0.0
API_PORT=8000

# Shadow Workspace 沙箱
# shadow 副本总大小上限（字节），超过则拒绝创建。默认 200MB=209715200
SHADOW_MAX_BYTES=209715200
# shadow 拷贝时跳过的目录名（逗号分隔），不会被复制到 shadow
SHADOW_SKIP_DIRS=.git,node_modules,.venv,__pycache__,.pytest_cache,dist,build,.superpowers
# shadow 中验证命令的默认超时秒数
SHADOW_VERIFY_TIMEOUT=120
