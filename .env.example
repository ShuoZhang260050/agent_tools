# LLM 配置
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-your-key-here
# 留空=官方端点；国产/本地模型填兼容端点，例如：
# 火山方舟 Ark: https://ark.cn-beijing.volces.com/api/v3  (模型名用 ark-code-latest 或 ep-xxxxx)
# 智谱 GLM:    https://open.bigmodel.cn/api/paas/v4
# 通义千问:    https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek:    https://api.deepseek.com
# 本地 Ollama: http://localhost:11434/v1
LLM_BASE_URL=
LLM_TEMPERATURE=0.7

# 上下文工程
TOKEN_BUDGET=500000
MODEL_CALL_LIMIT=25
SUMMARY_TRIGGER_MESSAGES=30
SUMMARY_KEEP_MESSAGES=10
JWT_SECRET=change-me-in-production
TOKEN_EXPIRE_HOURS=168

# SQLite checkpointer 文件路径
SQLITE_PATH=checkpoints.sqlite

# API 服务
API_HOST=0.0.0.0
API_PORT=8000
